root ::= "{" ws "\"intent_verb\":" ws verb ws "," ws "\"intent_object\":" ws object ws "," ws "\"inputs\":" ws inputs ws "," ws "\"target\":" ws target ws "," ws "\"constraints\":" ws constraints ws "}"

verb ::= "\"read\"" | "\"write\"" | "\"move\"" | "\"delete\"" | "\"create\"" | "\"find\"" | "\"list\"" | "\"filter\"" | "\"sort\"" | "\"group\"" | "\"classify\"" | "\"get\"" | "\"set\"" | "\"send\"" | "\"describe\"" | "\"render\"" | "\"extract\"" | "\"compress\"" | "\"compute\"" | "\"compare\"" | "\"change\"" | "\"order\"" | "\"share\""

object ::= "\"files\"" | "\"dirs\"" | "\"packages\"" | "\"messages\"" | "\"events\"" | "\"contacts\"" | "\"places\"" | "\"processes\"" | "\"urls\"" | "\"numbers\"" | "\"images\"" | "\"signatures\"" | "\"texts\"" | "\"proposals\"" | "\"persons\"" | "\"tasks\"" | "\"inputs\"" | "\"credentials\"" | "\"entries\""

inputs ::= "[" ws (input ("," ws input)*)? ws "]"
input ::= "{" ws "\"name\":" ws string ws "," ws "\"semantic_type\":" ws semtype ws "," ws "\"value\":" ws val ws "}"

semtype ::= "\"file_path\"" | "\"dir_path\"" | "\"image_path\"" | "\"pdf_path\"" | "\"url\"" | "\"email_address\"" | "\"phone\"" | "\"person_name\"" | "\"slug\"" | "\"account_name\"" | "\"time_window\"" | "\"iso_timestamp\"" | "\"glob_pattern\"" | "\"regex_pattern\"" | "\"count\"" | "\"scalar_metric\"" | "\"size_bytes\"" | "\"free_text\"" | "\"json_object\"" | "\"bool\"" | "\"name\""

target ::= "{" ws "\"semantic_type\":" ws ttype ws "," ws "\"shape\":" ws shape ws "}"

ttype ::= "\"scalar_metric\"" | "\"free_text\"" | "\"file_entry[]\"" | "\"image_entry[]\"" | "\"message_entry[]\"" | "\"event_entry[]\"" | "\"person_entry[]\"" | "\"url_entry[]\"" | "\"dir_entry[]\"" | "\"process_entry[]\"" | "\"task_entry[]\"" | "\"iso_timestamp\""

shape ::= "\"list\"" | "\"scalar\"" | "\"dict\""

constraints ::= "[" ws (constraint ("," ws constraint)*)? ws "]"
constraint ::= "{" ws "\"kind\":" ws ckind ws "," ws "\"key\":" ws string ws "," ws "\"value\":" ws val ws "}"

ckind ::= "\"filter\"" | "\"sort\"" | "\"aggregate\"" | "\"transform\""

string ::= "\"" ([^"\\\x00-\x1f]+ | "\\" ["\\/bfnrt]){0,80} "\""

val ::= string | number | "true" | "false" | "null"
number ::= ("-")? ([0-9]+ ("." [0-9]+)?)

ws ::= [ \t\n]*
