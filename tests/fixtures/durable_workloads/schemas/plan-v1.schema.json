{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metnos.local/schemas/durable-workloads/plan-v1.schema.json",
  "title": "Metnos durable plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "objective_redacted",
    "inventory",
    "terminal_criteria",
    "error_policy",
    "budgets",
    "stages",
    "required_artifacts"
  ],
  "properties": {
    "schema_version": {"const": "metnos.durable-plan/1"},
    "plan_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{2,63}$"},
    "objective_redacted": {"type": "string", "minLength": 1, "maxLength": 2048},
    "inventory": {"$ref": "#/$defs/inventory"},
    "terminal_criteria": {"$ref": "#/$defs/terminalCriteria"},
    "error_policy": {"$ref": "#/$defs/errorPolicy"},
    "budgets": {"$ref": "#/$defs/budgets"},
    "stages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"$ref": "#/$defs/stage"}
    },
    "required_artifacts": {
      "type": "array",
      "maxItems": 32,
      "items": {"$ref": "#/$defs/artifact"}
    }
  },
  "$defs": {
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "dynamic",
        "max_sources",
        "max_total_bytes",
        "max_depth",
        "symlink_policy",
        "unstable_policy",
        "missing_policy"
      ],
      "properties": {
        "mode": {"const": "sealed"},
        "dynamic": {"const": false},
        "max_sources": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "max_total_bytes": {"type": "integer", "minimum": 0},
        "max_depth": {"type": "integer", "minimum": 0, "maximum": 128},
        "symlink_policy": {"enum": ["ignore"]},
        "unstable_policy": {"enum": ["reject"]},
        "missing_policy": {"enum": ["needs_attention"]}
      }
    },
    "terminalCriteria": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "require_inventory_sealed",
        "require_usage_complete",
        "reject_unaccepted_truncation"
      ],
      "properties": {
        "require_inventory_sealed": {"const": true},
        "require_usage_complete": {"const": true},
        "reject_unaccepted_truncation": {"const": true}
      }
    },
    "errorPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "allowed_error_classes"],
      "properties": {
        "mode": {"enum": ["strict", "declared"]},
        "allowed_error_classes": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{1,63}$"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"mode": {"const": "strict"}}},
          "then": {"properties": {"allowed_error_classes": {"maxItems": 0}}}
        },
        {
          "if": {"properties": {"mode": {"const": "declared"}}},
          "then": {"properties": {"allowed_error_classes": {"minItems": 1}}}
        }
      ]
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_units",
        "max_attempts_per_unit",
        "max_wall_time_s",
        "max_bytes_read",
        "max_bytes_written",
        "max_tokens",
        "max_cost_micros",
        "max_artifacts",
        "max_concurrency"
      ],
      "properties": {
        "max_units": {"type": "integer", "minimum": 1, "maximum": 10000000},
        "max_attempts_per_unit": {"type": "integer", "minimum": 1, "maximum": 32},
        "max_wall_time_s": {"type": "integer", "minimum": 1, "maximum": 2592000},
        "max_bytes_read": {"type": "integer", "minimum": 0},
        "max_bytes_written": {"type": "integer", "minimum": 0},
        "max_tokens": {"type": "integer", "minimum": 0},
        "max_cost_micros": {"type": "integer", "minimum": 0},
        "max_artifacts": {"type": "integer", "minimum": 0, "maximum": 1024},
        "max_concurrency": {"type": "integer", "minimum": 1, "maximum": 256}
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "type",
        "depends_on",
        "runner",
        "effect_profile",
        "cardinality",
        "input_bindings",
        "output_schema",
        "retry",
        "timeout_s",
        "invalidation_keys",
        "resources",
        "required"
      ],
      "properties": {
        "key": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,63}$"},
        "type": {"enum": ["inventory", "map", "reduce", "validate", "publish"]},
        "depends_on": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,63}$"}
        },
        "runner": {"$ref": "#/$defs/runner"},
        "effect_profile": {"enum": ["pure", "idempotent", "reconcilable", "manual_only"]},
        "cardinality": {"$ref": "#/$defs/cardinality"},
        "input_bindings": {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": {"pattern": "^[a-z][a-z0-9_]{0,63}$"},
          "additionalProperties": {"$ref": "#/$defs/reference"}
        },
        "output_schema": {"$ref": "#/$defs/schemaReference"},
        "retry": {"$ref": "#/$defs/retry"},
        "timeout_s": {"type": "integer", "minimum": 1, "maximum": 86400},
        "invalidation_keys": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "enum": [
              "source.digest",
              "dependencies.digest",
              "runner.contract_digest",
              "semantic_args.digest",
              "model_binding.digest",
              "prompt.digest",
              "reduction.order",
              "reduction.fan_in"
            ]
          }
        },
        "resources": {"$ref": "#/$defs/resources"},
        "required": {"type": "boolean"}
      },
      "allOf": [
        {
          "if": {"properties": {"effect_profile": {"const": "manual_only"}}},
          "then": {
            "properties": {
              "retry": {"properties": {"max_attempts": {"const": 1}}}
            }
          }
        },
        {
          "if": {"properties": {"type": {"const": "inventory"}}},
          "then": {
            "properties": {
              "depends_on": {"maxItems": 0},
              "runner": {
                "properties": {
                  "kind": {"const": "internal"},
                  "name": {"const": "sealed_inventory"}
                }
              },
              "cardinality": {"properties": {"mode": {"const": "singleton"}}}
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {"const": "publish"},
              "runner": {"properties": {"kind": {"const": "internal"}}}
            }
          },
          "then": {
            "properties": {
              "runner": {"properties": {"name": {"const": "artifact_store_publish"}}},
              "effect_profile": {"const": "idempotent"}
            }
          }
        }
      ]
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name"],
      "properties": {
        "kind": {"enum": ["internal", "executor", "workload"]},
        "name": {"type": "string", "pattern": "^[a-z_][a-z0-9_.-]{1,95}$"}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "internal"}}},
          "then": {
            "properties": {
              "name": {
                "enum": [
                  "sealed_inventory",
                  "schema_and_coverage_validator",
                  "artifact_store_publish"
                ]
              }
            }
          }
        }
      ]
    },
    "cardinality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "max_units"],
      "properties": {
        "mode": {"enum": ["singleton", "per_source", "per_dependency"]},
        "max_units": {"type": "integer", "minimum": 1, "maximum": 10000000},
        "entry_identity_field": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        }
      },
      "allOf": [
        {
          "if": {"required": ["entry_identity_field"]},
          "then": {"properties": {"mode": {"const": "per_dependency"}}}
        }
      ]
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref"],
      "properties": {
        "ref": {
          "enum": [
            "revision.inventory",
            "source.path",
            "source.record",
            "dependency.result",
            "dependency.entries"
          ]
        },
        "stage": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,63}$"},
        "field": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,128}$"}
      }
    },
    "schemaReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "name"],
      "properties": {
        "schema_version": {"const": "metnos.output-schema-ref/1"},
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{2,127}/[1-9][0-9]*$"}
      }
    },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_attempts", "base_delay_ms", "max_delay_ms", "retryable_error_classes"],
      "properties": {
        "max_attempts": {"type": "integer", "minimum": 1, "maximum": 32},
        "base_delay_ms": {"type": "integer", "minimum": 0, "maximum": 86400000},
        "max_delay_ms": {"type": "integer", "minimum": 0, "maximum": 86400000},
        "retryable_error_classes": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{1,63}$"}
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu", "local_io", "network_io", "llm", "vlm", "device"],
      "properties": {
        "cpu": {"type": "integer", "minimum": 0, "maximum": 64},
        "local_io": {"type": "integer", "minimum": 0, "maximum": 64},
        "network_io": {"type": "integer", "minimum": 0, "maximum": 64},
        "llm": {"type": "integer", "minimum": 0, "maximum": 32},
        "vlm": {"type": "integer", "minimum": 0, "maximum": 32},
        "device": {"type": "integer", "minimum": 0, "maximum": 64}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "mime_type", "schema_version", "publication"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,63}$"},
        "mime_type": {"type": "string", "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$"},
        "schema_version": {"type": "string", "pattern": "^metnos\\.[a-z0-9_.-]+/[1-9][0-9]*$"},
        "publication": {"const": "internal_store"}
      }
    }
  }
}
