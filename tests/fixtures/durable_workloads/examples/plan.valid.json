      "invalidation_keys": ["source.digest", "runner.contract_digest", "semantic_args.digest"],
      "resources": {"cpu": 1, "local_io": 1, "network_io": 0, "llm": 0, "vlm": 1, "device": 1},
      "required": true
    },
    {
      "key": "observe",
      "type": "map",
      "depends_on": ["inventory"],
      "runner": {"kind": "executor", "name": "describe_images"},
      "effect_profile": "pure",
      "cardinality": {"mode": "per_source", "max_units": 50000},
      "input_bindings": {"paths": {"ref": "source.path"}},
      "output_schema": {"schema_version": "metnos.output-schema-ref/1", "name": "metnos.executor.describe-images/1"},
      "retry": {"max_attempts": 3, "base_delay_ms": 2000, "max_delay_ms": 60000, "retryable_error_classes": ["executor_transient", "capability_unavailable"]},
      "timeout_s": 300,
      "invalidation_keys": ["source.digest", "runner.contract_digest", "model_binding.digest", "prompt.digest"],
      "resources": {"cpu": 0, "local_io": 1, "network_io": 0, "llm": 0, "vlm": 1, "device": 0},
