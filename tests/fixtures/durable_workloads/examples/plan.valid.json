      "input_bindings": {"entries": {"ref": "dependency.entries", "stage": "answer"}},
      "output_schema": {"schema_version": "metnos.output-schema-ref/1", "name": "metnos.image-reduction-node/1"},
      "retry": {"max_attempts": 3, "base_delay_ms": 2000, "max_delay_ms": 60000, "retryable_error_classes": ["executor_transient"]},
      "timeout_s": 300,
      "invalidation_keys": ["dependencies.digest", "model_binding.digest", "prompt.digest", "reduction.order", "reduction.fan_in"],
      "resources": {"cpu": 0, "local_io": 0, "network_io": 0, "llm": 1, "vlm": 0, "device": 0},
      "required": true
    },
    {
      "key": "validate",
      "type": "validate",
      "depends_on": ["answer", "reduce"],
      "runner": {"kind": "internal", "name": "schema_and_coverage_validator"},
      "effect_profile": "pure",
      "cardinality": {"mode": "singleton", "max_units": 1},
      "input_bindings": {"items": {"ref": "dependency.entries", "stage": "answer"}, "summary": {"ref": "dependency.result", "stage": "reduce"}},
      "output_schema": {"schema_version": "metnos.output-schema-ref/1", "name": "metnos.image-preset-output/1"},
      "retry": {"max_attempts": 1, "base_delay_ms": 0, "max_delay_ms": 0, "retryable_error_classes": []},
      "timeout_s": 300,
      "invalidation_keys": ["dependencies.digest"],
      "resources": {"cpu": 1, "local_io": 0, "network_io": 0, "llm": 0, "vlm": 0, "device": 0},
      "required": true
    },
    {
      "key": "publish",
      "type": "publish",
      "depends_on": ["validate"],
      "runner": {"kind": "internal", "name": "artifact_store_publish"},
      "effect_profile": "idempotent",
      "cardinality": {"mode": "singleton", "max_units": 2},
      "input_bindings": {"validated": {"ref": "dependency.result", "stage": "validate"}},
      "output_schema": {"schema_version": "metnos.output-schema-ref/1", "name": "metnos.internal-artifacts/1"},
      "retry": {"max_attempts": 3, "base_delay_ms": 1000, "max_delay_ms": 30000, "retryable_error_classes": ["executor_transient"]},
      "timeout_s": 300,
      "invalidation_keys": ["dependencies.digest"],
      "resources": {"cpu": 0, "local_io": 1, "network_io": 0, "llm": 0, "vlm": 0, "device": 0},
      "required": true
    }
  ],
  "required_artifacts": [
    {"name": "analysis_json", "mime_type": "application/json", "schema_version": "metnos.image-preset-output/1", "publication": "internal_store"},
    {"name": "report_markdown", "mime_type": "text/markdown", "schema_version": "metnos.image-preset-report/1", "publication": "internal_store"}
  ]
}
