      "runner": {"kind": "workload", "name": "durable.images.answer"},
      "effect_profile": "pure",
      "cardinality": {"mode": "per_source", "max_units": 50000},
      "input_bindings": {
        "ocr": {"ref": "dependency.result", "stage": "ocr"},
        "visual": {"ref": "dependency.result", "stage": "observe"}
