# Metnos — .gitignore
# Lingua: italiano (§7.8). Convenzione: una riga per pattern, raggruppate per
# motivo. Non escludere `*.sig` (firme executor parte del catalogo).

# --- Python bytecode e cache ---------------------------------------------
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/

# --- Virtualenv locali ----------------------------------------------------
.venv*/
venv/
env/

# --- Build artefatti Rust del client --------------------------------------
client-rs/target/

# --- Dipendenze JS / node_modules / wrangler ------------------------------
node_modules/
.wrangler/

# --- Modelli LLM/VLM (decine di GB, scaricabili da install/manifest) ------
models/

# --- Log e backup runtime -------------------------------------------------
*.log
*.log.*
data/*.log

# --- Credenziali e segreti ------------------------------------------------
# OAuth client secret Google, ecc.: NIENTE in repo.
*.key
*.secret
*.pem
*.p12
.env
.env.*
client_secret_*.json
~/.config/metnos/

# --- Editor / IDE ---------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# --- Coverage / report locali ---------------------------------------------
htmlcov/
.coverage
.coverage.*
coverage.xml

# --- SQLite ephemerals (WAL/SHM/backup) -----------------------------------
*.sqlite-wal
*.sqlite-shm
*.db-wal
*.db-shm
*.bak.*

# --- Note: ~/.local/share/metnos/ e ~/.cache/metnos/ vivono fuori da
# /opt/metnos, quindi non necessitano regole qui (sono outside-worktree).

# --- Dati personali / runtime utente / ambiente sviluppo .33 -------------
# Mai versionati nel repo pubblico (ADR 0145 scrub L1).
workspace/
_history/
.claude/
claude_persistent.sh
.review_status.md
x.png
*.png.bak

# --- ADR registry: TRACCIATO nel git di lavoro (baseline), NON su GitHub ---
# Modello distribuzione (5/6/2026): /opt/metnos = baseline completo versionato;
# il repo pubblico = EXPORT-subset (scripts/export-public.sh) che ESCLUDE
# decisions/ e docs/ (rationale interno, vivono su metnos.com). Gli ADR restano
# tracciati qui per storia/backup ma NON entrano nel repo pubblico.
# (decisions/ volutamente NON ignorato)

# --- Tutta la documentazione (NOT for GitHub, vive su metnos.com) --------
docs/*
!docs/it/
!docs/en/
docs/it/*
docs/en/*
!docs/it/architecture/
!docs/en/architecture/
docs/it/architecture/*
docs/en/architecture/*
!docs/it/architecture/remote_executors.html
!docs/en/architecture/remote_executors.html
!docs/it/architecture/intelligent_executors.html
!docs/en/architecture/intelligent_executors.html
!docs/it/architecture/executor_catalog.html
!docs/en/architecture/executor_catalog.html
!docs/assets/
docs/assets/*
!docs/assets/architecture-flow.png
!docs/assets/metnos.css
!docs/assets/quicktour-print.css

# --- Doc agente / harness Claude (internal) ------------------------------
AGENTS.md
CLAUDE.md

# --- Dev tooling, bench, stress (non parte runtime utente) ---------------
runtime/bench_*.py
runtime/bench_*.sh
runtime/stress/
runtime/testing/
runtime/prompts.toml
runtime/.review_status.md

# --- Decision/test stress artifacts --------------------------------------
decisions/synt_stress/

# --- Test result dumps con dati interni (ADR 0145) -----------------------
decisions/synt_stress/
decisions/executor_requests.jsonl
decisions/executor_diary.md
*.jsonl

# --- Sqlite full (non solo WAL/SHM) --------------------------------------
*.sqlite
*.sqlite-journal
*.db

# --- Modelli (gia' models/ ma esplicito difesa in profondita') -----------
*.gguf
*.onnx
*.bin
*.safetensors

# --- Cloudflare dev-only (ADR 0144, ADR 0145) ----------------------------
deploy.sh
.cloudflare/
wrangler.toml
cloudflare/

# --- GitHub Actions cache locali / artefatti tooling ---------------------
.github/cache/

# --- E2E simulator: cache di parsing/typing (artefatti generati) ---------
e2e/simulator/parse_cache/
e2e/simulator/parse_cache_dedicated/
e2e/simulator/parse_cache.pre_D/
e2e/simulator/typing_cache/

# --- GitHub workflow: stato runtime delle issue (dati, non codice) -------
/issues/

# --- Memoria persistente assistente (mai in repo) ------------------------
MEMORY.md
SOUL.md
TELOS.md
IDENTITY.md
USER.md

# --- File temporanei dell'IDE / OS ---------------------------------------
*~
.~lock.*
UTENZE E SPESE/
/ANALISI MEDICHE E CERTIFICATI/

# --- Artefatto export pubblico (rigenerabile) ---------------------------
dist/
to_delete/

# Chiavi service account Google (segreti — mai in git)
/metnos-*.json
*-sa.json
google_*_sa.json
