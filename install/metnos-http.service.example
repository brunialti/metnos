# Metnos HTTP API + admin dashboard — example systemd unit.
#
# Copy to /etc/systemd/system/metnos-http.service, edit the paths/user marked
# __LIKE_THIS__, then:
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now metnos-http
#   curl http://127.0.0.1:8770/agent/health
#
# Public builds bring their own AI backend (a llama-server endpoint + ONNX
# embeddings); the reference instance adds suprastructure to PYTHONPATH — drop
# that path if you don't use it.

[Unit]
Description=Metnos HTTP API + admin dashboard (:8770)
After=network.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
# __PYTHON__ = your venv python; __INSTALL_ROOT__ = the repo checkout.
ExecStart=/opt/metnos/.venv/bin/python /opt/metnos/runtime/metnos_http_server.py --host 0.0.0.0 --port 8770
User=__USER__
WorkingDirectory=/opt/metnos
Restart=on-failure
RestartSec=10
Environment=HOME=/home/__USER__
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/metnos:/opt/metnos/runtime
Environment=METNOS_HTTP_HOST=0.0.0.0
Environment=METNOS_HTTP_PORT=8770
# Reasoning budget for the local planner (tune to your LLM).
Environment=METNOS_REASONING_BUDGET=4096
# Praxis engine (fast deterministic path) + planner fallback on error.
Environment=METNOS_PRAXIS=1
Environment=METNOS_PRAXIS_FALLBACK=1
Environment=METNOS_PLANNER_LEGACY=0
# Bring-your-own AI backend: 'local' = llama-server + ONNX embeddings.
# Remove to use suprastructure (reference instance only).
Environment=METNOS_AI_BACKEND=local

[Install]
WantedBy=multi-user.target
