[Unit]
Description=Metnos backup timer — ogni giorno alle 03:35

[Timer]
OnCalendar=*-*-* 03:35:00
AccuracySec=60
# Persistent=true: se il sistema era down all'orario schedulato, esegue
# il backup al primo boot utile (evita di saltare giornate dopo un reboot).
Persistent=true

[Install]
WantedBy=timers.target
