[Unit]
Description=Metnos bounded localization worker (RM-0005)
After=network-online.target metnos-backup.service
Wants=network-online.target

[Service]
Type=oneshot
# Job notturno: legge la richiesta d'istanza firmata, aggiorna il registro
# versionato, elabora un batch limitato e riesegue i gate. Non attiva la lingua.
ExecStart=/opt/metnos/deploy/run_prompts_translator.sh
User=roberto
WorkingDirectory=/opt/metnos
Environment=PYTHONPATH=/opt/metnos/runtime
Environment=METNOS_LOCALIZATION_CAP_PER_FIRE=20
# Nota: il timer associato lancia questa unit ogni notte alle 04:30
# (55 min dopo metnos-backup per evitare contesa CPU/IO con backup).
