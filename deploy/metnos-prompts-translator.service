[Unit]
Description=Metnos prompts auto-translator (ADR 0092 Phase 3)
After=network-online.target metnos-backup.service
Wants=network-online.target

[Service]
Type=oneshot
# Job notturno: scansiona prompts/it/*.j2 modificati negli ultimi 7 giorni
# e per ognuno, se il corrispondente prompts/<lang>/<role>.j2 ha mtime
# precedente, triggera translate_prompt_file via i18n_translator.
#
# Output: candidati in prompts/<lang>/_pending/ (review umana obbligatoria
# prima di mark-synced). Notifica via Telegram al host se candidati > 0.
ExecStart=/opt/myclaw/deploy/run_prompts_translator.sh
User=roberto
WorkingDirectory=/opt/myclaw
Environment=PYTHONPATH=/opt/myclaw/runtime
# Tier LLM per la traduzione. Override via env nel systemd unit:
#   "wise"     = Gemma 4 26B locale (default, gratuito).
#   "frontier" = Anthropic Opus 4.7 (~$0.015/call, opt-in).
# Il wrapper `run_prompts_translator.sh` legge anche
# `~/.config/metnos/translator_tier.toml` (scritto da
# `metnos-prompts audit-quality --apply`) come fallback se la env var
# non e' settata.
Environment=METNOS_TRANSLATOR_QUALITY=wise
# Nota: il timer associato lancia questa unit ogni notte alle 04:30
# (55 min dopo metnos-backup per evitare contesa CPU/IO con backup).
