              "enum": [
                "actor.current",
                "actor.quoted",
                "artifact.explicit",
                "context.current_place",
                "context.current_spatial",
                "files.current_position",
                "files.explicit",
                "person.explicit",
                "place.explicit",
                "principal.explicit",
                "process.explicit",
                "time.current",
                "time.historical_explicit",
                "time.quoted_context"
