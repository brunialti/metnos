  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "atoms": {
          "$ref": "#/$defs/atoms"
        },
        "status": {
          "const": "supported"
        },
        "unsupported_clauses": {
          "items": {
            "$ref": "#/$defs/unsupported_clause"
          },
          "maxItems": 8,
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "status",
        "atoms"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "alternatives": {
          "items": {
            "additionalProperties": false,
