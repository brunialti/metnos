              "type": "string"
            }
          },
          "required": [
            "kind",
            "ref",
            "proof"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "output"
            },
            "proof": {
              "$ref": "#/$defs/proof"
            }
          },
          "required": [
            "kind",
            "proof"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "from_prior_atom"
            },
            "proof": {
              "$ref": "#/$defs/proof"
            },
            "source_ordinal": {
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "proof",
            "source_ordinal"
          ],
          "type": "object"
        }
      ]
    },
    "projection_atom": {
