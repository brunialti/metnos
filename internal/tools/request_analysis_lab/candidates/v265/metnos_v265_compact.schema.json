        "atom_kind": {
          "const": "dependency"
        },
        "clause_end_segment_id": {
          "minimum": 1,
          "type": "integer"
        },
        "clause_start_segment_id": {
          "minimum": 1,
          "type": "integer"
        },
        "relation": {
          "enum": [
            "spatial.located_at",
            "identity.same_as",
            "filesystem.located_at",
            "runtime.host_of",
            "spatial.near",
            "acl.share",
            "communication.send",
            "movement.destination",
            "workflow.position",
            "document.position"
