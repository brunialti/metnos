      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/projection_atom"
          },
          {
            "$ref": "#/$defs/dependency_atom"
          }
        ]
      },
      "maxItems": 16,
      "minItems": 1,
      "type": "array"
    },
    "dependency_atom": {
      "additionalProperties": false,
      "properties": {
