{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "urn:metnos:intent-shadow:model-document:0.1",
 "title": "Metnos intent shadow 0.1",
 "oneOf": [
  {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "kind": {
     "const": "operation_graph"
    },
    "body": {
     "$ref": "#/$defs/nonempty_body"
    }
   },
   "required": [
    "kind",
    "body"
   ]
  },
  {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "kind": {
     "const": "system_control"
    },
    "control": {
     "const": "undo_last_turn"
    }
   },
   "required": [
    "kind",
    "control"
   ]
  },
  {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "kind": {
     "const": "unrepresentable"
    },
    "reason": {
     "type": "string",
     "enum": [
      "ambiguous_intent",
      "missing_required_information",
      "mixed_root_kinds",
      "no_actionable_intent",
      "outside_registry",
      "unsupported_dependency"
     ]
    }
   },
   "required": [
    "kind",
    "reason"
   ]
  }
 ],
 "$defs": {
  "data_edge": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "from": {
     "type": "integer",
     "minimum": 0
    },
    "output": {
     "type": "string",
     "minLength": 1
    },
    "input": {
     "type": "string",
     "minLength": 1
    }
   },
   "required": [
    "from"
   ]
  },
  "data_edges": {
   "type": "array",
   "minItems": 1,
   "items": {
    "$ref": "#/$defs/data_edge"
   }
  },
  "node": {
   "oneOf": [
    {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "kind": {
       "const": "operation"
      },
      "route": {
       "type": "string",
       "enum": [
        "change/files",
        "change/pulls",
        "compress/files",
        "compute/entries",
        "compute/files",
        "compute/signatures",
        "consult/frontier",
        "create/calendars",
        "create/dirs",
        "create/events",
        "create/files",
        "create/images",
        "create/issues",
        "create/tasks",
        "delete/calendars",
        "delete/credentials",
        "delete/dirs",
        "delete/events",
        "delete/files",
        "delete/images",
        "delete/issues",
        "delete/messages",
        "delete/persons",
        "delete/tasks",
        "describe/numbers",
        "filter/entries",
        "filter/lists",
        "filter/texts",
        "find/contacts",
        "find/credentials",
        "find/dirs",
        "find/events",
        "find/files",
        "find/images",
        "find/issues",
        "find/packages",
        "find/persons",
        "find/places",
        "find/pulls",
        "find/urls",
        "get/files",
        "get/images",
        "get/inputs",
        "get/location",
        "get/now",
        "get/persons",
        "get/places",
        "get/processes",
        "get/proposals",
        "get/signatures",
        "get/urls",
        "group/entries",
        "list/dirs",
        "list/skills",
        "list/tasks",
        "login/session",
        "move/files",
        "move/messages",
        "read/contacts",
        "read/events",
        "read/files",
        "read/issues",
        "read/messages",
        "read/persons",
        "read/pulls",
        "read/tasks",
        "read/urls",
        "reply/messages",
        "send/messages",
        "set/credentials",
        "set/issues",
        "set/messages",
        "set/persons",
        "set/pulls",
        "set/signatures",
        "set/skills",
        "set/tasks",
        "share/files",
        "sort/entries",
        "write/files"
       ]
      },
      "data_from": {
       "$ref": "#/$defs/data_edges"
      }
     },
     "required": [
      "kind",
      "route"
     ]
    },
    {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "kind": {
       "const": "barrier"
      },
      "barrier": {
       "const": "get/approval"
      },
      "cases": {
       "type": "array",
       "minItems": 1,
       "maxItems": 2,
       "items": {
        "oneOf": [
         {
          "type": "object",
          "additionalProperties": false,
          "properties": {
           "outcome": {
            "const": "approved"
           },
           "body": {
            "$ref": "#/$defs/nonempty_body"
           }
          },
          "required": [
           "outcome",
           "body"
          ]
         },
         {
          "type": "object",
          "additionalProperties": false,
          "properties": {
           "outcome": {
            "const": "rejected"
           },
           "body": {
            "$ref": "#/$defs/nonempty_body"
           }
          },
          "required": [
           "outcome",
           "body"
          ]
         }
        ]
       }
      }
     },
     "required": [
      "kind",
      "barrier",
      "cases"
     ]
    }
   ]
  },
  "nonempty_body": {
   "type": "array",
   "minItems": 1,
   "items": {
    "$ref": "#/$defs/node"
   }
  }
 }
}
