{
  "suite_version": "metnos.question-focus-negative-controls/1.0",
  "created_at": "2026-08-08",
  "purpose": "Frozen semantic controls for current-actor location binding. No case is derived from candidate output.",
  "contract": {
    "positive_tuple": {
      "speech_act": "open_question",
      "relation": "located_at",
      "focus_role": "location",
      "entity_ref": "current_actor",
      "time_ref": "current"
    },
    "binding_id": "runtime.current_location",
    "rule": "The binding is expected if and only if the complete positive tuple holds. Using current location as an operand or precursor is not a positive."
  },
  "cases": [
    {
      "id": "pos.it.reflexive",
      "lang": "it",
      "query": "dove mi trovo",
      "tuple": ["open_question", "located_at", "location", "current_actor", "current"],
      "expect_binding": true
    },
